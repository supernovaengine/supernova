// Configured by CMake into the build directory, edit this file and not the copy.
//
// GLFW looks up this exact resource name to set the initial window/taskbar
// icon, and the editor never calls glfwSetWindowIcon at runtime, so the name
// has to stay GLFW_ICON. Explorer picks it up too: it shows the first icon
// group in the executable, and named entries precede numbered ones. Exported
// games instead use "1 ICON" (see Exporter.cpp), because they set the window
// icon at runtime from app_icon.h.
//
// Expands to nothing for doriax.dll, which has no window and no Explorer icon
// but still needs the version block below to be signed.
@DORIAX_ICON_RESOURCE@

// Constants are spelled out because the resource is compiled without an include path
#ifndef VS_VERSION_INFO
#define VS_VERSION_INFO 1
#endif

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    @DORIAX_VERSION_NUMERIC@
    PRODUCTVERSION @DORIAX_VERSION_NUMERIC@
    FILEFLAGSMASK  0x3fL
    FILEFLAGS      0x0L
    FILEOS         0x40004L // VOS_NT_WINDOWS32
    FILETYPE       @DORIAX_FILE_TYPE@
    FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0" // U.S. English, Unicode
        BEGIN
            VALUE "CompanyName",      "Doriax Engine Community\0"
            VALUE "FileDescription",  "@DORIAX_FILE_DESCRIPTION@\0"
            VALUE "FileVersion",      "@DORIAXEDITOR_VERSION@\0"
            VALUE "InternalName",     "@DORIAX_INTERNAL_NAME@\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Eduardo Doria and contributors. MIT License.\0"
            VALUE "OriginalFilename", "@DORIAX_ORIGINAL_FILENAME@\0"
            VALUE "ProductName",      "Doriax Engine\0"
            VALUE "ProductVersion",   "@DORIAXEDITOR_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
